<!-- Rough-terrain scene for the Unitree H1. The height field is filled in per environment by
     h1_rl/terrain.py: one patch per robot, seamless across its edges so a robot that walks out
     of the patch is wrapped back to the other side without any step in the ground under it. -->
<mujoco model="h1 terrain scene">
  <include file="h1.xml"/>

  <option timestep="0.005" integrator="implicitfast" iterations="10" ls_iterations="20"/>

  <statistic center="0 0 0.9" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-15" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="12 12" reflectance="0.0"/>
    <!-- size: half-length x, half-length y, elevation, base thickness (metres) -->
    <hfield name="terrain" nrow="160" ncol="160" size="6 6 0.30 0.5"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="hfield" hfield="terrain" material="groundplane" pos="0 0 0"
      contype="1" conaffinity="1" friction="1.0 0.02 0.01"/>
  </worldbody>
</mujoco>
