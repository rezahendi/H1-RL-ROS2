<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>h1_rl</name>
  <version>0.1.0</version>
  <description>
    Reinforcement-learning walking controller for the Unitree H1 humanoid:
    MuJoCo training environment + PPO, a MuJoCo simulator node and a policy
    controller node for ROS 2.
  </description>
  <maintainer email="rezahendi590@gmail.com">Reza</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>h1_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <!-- mujoco (and torch for training) come from pip: see README -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
